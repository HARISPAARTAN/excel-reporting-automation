<?xml version="1.0" encoding="UTF-8"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo><Description>Cedarline weekly report, Mondays 07:00 local time</Description></RegistrationInfo>
  <Triggers><CalendarTrigger><StartBoundary>2025-09-22T07:00:00</StartBoundary><Enabled>true</Enabled><ScheduleByWeek><WeeksInterval>1</WeeksInterval><DaysOfWeek><Monday /></DaysOfWeek></ScheduleByWeek></CalendarTrigger></Triggers>
  <Principals><Principal id="Author"><LogonType>InteractiveToken</LogonType><RunLevel>LeastPrivilege</RunLevel></Principal></Principals>
  <Settings><MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy><DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries><StopIfGoingOnBatteries>false</StopIfGoingOnBatteries><StartWhenAvailable>true</StartWhenAvailable><RunOnlyIfNetworkAvailable>true</RunOnlyIfNetworkAvailable><Enabled>true</Enabled><ExecutionTimeLimit>PT30M</ExecutionTimeLimit></Settings>
  <Actions Context="Author"><Exec><Command>%USERPROFILE%\.local\bin\uv.exe</Command><Arguments>run build-report --log-file D:\Cedarline\Reports\build-report.log run --period last --input D:\Cedarline\Incoming --out D:\Cedarline\Reports --notify smtp</Arguments><WorkingDirectory>D:\Cedarline\build-report</WorkingDirectory></Exec></Actions>
</Task>
